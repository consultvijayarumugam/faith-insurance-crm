# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, never exposed to the browser.
# Used by admin API routes (e.g. inviting agents) that must bypass RLS.
# Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for /api/cron/retention-cleanup. Set the same value as a
# Vercel project env var — Vercel's Cron Jobs feature then attaches it
# automatically as `Authorization: Bearer $CRON_SECRET` on every scheduled
# call, which the route checks. Generate with `openssl rand -hex 32`.
CRON_SECRET=your-cron-secret
